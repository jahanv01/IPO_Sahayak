# Copy to .env for local dev. Never commit the real .env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:5173

# Epic 3: AI / search engine (ask.py, app/answer.py, app/retrieval.py)
# Use the Supabase Transaction pooler URI for DATABASE_URL above (see pipeline/.env.example) —
# the direct-connection URI is IPv6-only and unreachable from some networks/CI runners.
# Free-tier key from https://aistudio.google.com/apikey — no billing needed.
GEMINI_API_KEY=
# gemini-flash-latest for dev/testing (default if unset, free tier), gemini-pro-latest for demo polish
GEMINI_MODEL=gemini-flash-latest
